generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Conexão direta (sem pooling), usada só pelo Prisma Migrate.
  // Em provedores serverless (Neon, Supabase) DATABASE_URL é a pooled connection
  // e DIRECT_URL é a conexão direta ao Postgres. Em dev local as duas apontam
  // para o mesmo Postgres, então podem ter o mesmo valor.
  directUrl = env("DIRECT_URL")
}

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  CREDIT_CARD
  INVESTMENT
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum TxType {
  INCOME
  EXPENSE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  sessions     RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
}

model Account {
  id             String      @id @default(cuid())
  userId         String
  name           String
  type           AccountType
  currency       String      @default("BRL")
  initialBalance Int         @default(0)
  color          String?
  archivedAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId, deletedAt])
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  name      String
  kind      CategoryKind
  icon      String?
  color     String?
  parentId  String?
  deletedAt DateTime?

  parent       Category?     @relation("CatTree", fields: [parentId], references: [id])
  children     Category[]    @relation("CatTree")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name, kind])
  @@index([userId, kind, deletedAt])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  accountId   String?
  categoryId  String?
  type        TxType
  amount      Int
  date        DateTime @db.Date
  description String?
  notes       String?
  paid        Boolean  @default(true)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account?  @relation(fields: [accountId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([userId, date(sort: Desc)])
  @@index([userId, accountId, date])
  @@index([userId, categoryId, date])
}
